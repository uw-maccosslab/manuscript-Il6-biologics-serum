y=PCA_x$PC2,
name = row.names(PCA_x),
marker = list(color = color_pal, size = 9)
) %>%
layout(title="PCA",
xaxis=list(title="PCA1"),
yaxis=list(title="PCA2"))
sample_cols <- c(
grep("^P\\d{2}_", colnames(protein_data), value = TRUE),
grep("^S\\d{2}_", colnames(protein_data), value = TRUE),
grep("^PlasmaTotal_", colnames(protein_data), value = TRUE),
grep("^SerumTotal_", colnames(protein_data), value = TRUE)
)
protein_data_matrix <- protein_data %>%
select(GeneName, all_of(sample_cols)) %>%
filter(if_all(all_of(sample_cols), ~ !is.na(.) & !is.infinite(.)))
gene_names <- protein_data_matrix$GeneName
mat <- protein_data_matrix %>%
select(all_of(sample_cols)) %>%
as.matrix()
rownames(mat) <- gene_names
## --- 2. Run PCA on samples (rows = samples after transpose) -----------
PCA <- prcomp(t(mat), scale. = TRUE)
PCA_x <- as.data.frame(PCA$x)
PCA_x$sample <- rownames(PCA_x)
## --- 3. Assign group labels for coloring -------------------------------
PCA_x <- PCA_x %>%
mutate(group = case_when(
grepl("^P\\d{2}_", sample) ~ "Plasma_EV",
grepl("^S\\d{2}_", sample) ~ "Serum_EV",
grepl("^PlasmaTotal_", sample) ~ "Plasma_total",
grepl("^SerumTotal_", sample) ~ "Serum_total"
))
## --- 4. Scores plot -----------------------------------------------------
ggplot(PCA_x, aes(x = PC1, y = PC2, color = group)) +
geom_point(size = 4, stroke = 0) +
scale_color_manual(values = c(
"Plasma_EV"    = "#7B2FBE",
"Serum_EV"     = "#F2C438",
"Plasma_total" = "#377EB8",
"Serum_total"  = "#D72638"
)) +
theme_cowplot() +
labs(x = "PC1", y = "PC2", color = NULL)
## --- 5. Loadings plot, labeled by GeneName -----------------------------
PCA_loadings <- as.data.frame(PCA$rotation)
PCA_loadings$GeneName <- rownames(PCA_loadings)
# label only the most extreme loadings (top 10 by distance from origin), else it'll be unreadable
top_loadings <- PCA_loadings %>%
mutate(dist = sqrt(PC1^2 + PC2^2)) %>%
slice_max(dist, n = 10)
ggplot(PCA_loadings, aes(x = PC1, y = PC2)) +
geom_point(color = "grey60", size = 1, alpha = 0.5) +
geom_text_repel(data = top_loadings, aes(label = GeneName),
size = 3, fontface = "bold", max.overlaps = 15) +
geom_hline(yintercept = 0, linetype = "dashed") +
geom_vline(xintercept = 0, linetype = "dashed") +
theme_cowplot() +
labs(x = "PC1 loading", y = "PC2 loading", title = "PCA loadings")
color_map <- c(
"Plasma_EV"    = "#7B2FBE",
"Serum_EV"     = "#F2C438",
"Plasma_total" = "#377EB8",
"Serum_total"  = "#D72638"
)
plot_ly(x = PCA_x$PC1,
y = PCA_x$PC2,
text = PCA_x$sample,
color = PCA_x$group,
colors = color_map,
marker = list(size = 9)
) %>%
layout(title = "PCA",
xaxis = list(title = "PCA1"),
yaxis = list(title = "PCA2"))
sample_cols <- c(
grep("^P\\d{2}_", colnames(protein_data), value = TRUE),
grep("^S\\d{2}_", colnames(protein_data), value = TRUE),
grep("^PlasmaTotal_", colnames(protein_data), value = TRUE),
grep("^SerumTotal_", colnames(protein_data), value = TRUE)
)
protein_data_matrix <- protein_data %>%
select(GeneName, all_of(sample_cols)) %>%
filter(if_all(all_of(sample_cols), ~ !is.na(.) & !is.infinite(.)))
gene_names <- protein_data_matrix$GeneName
mat <- protein_data_matrix %>%
